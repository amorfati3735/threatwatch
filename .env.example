# ---------------------------------------------------------------------------
# ThreatWatch configuration
# Copy to `.env` and edit.  `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WEBSOCKET_FPS=20

# --- camera / vision ------------------------------------------------------
# Set THREATWATCH_VISION=0 (or run `python run.py --no-vision`) to disable the
# camera and pose detection entirely.
THREATWATCH_VISION=1
CAMERA_INDEX=0
YOLO_MODEL_NAME=yolov8n-pose.pt

# --- hardware link --------------------------------------------------------
SERIAL_PORT=COM3
SERIAL_BAUD=115200

# ---------------------------------------------------------------------------
# THREAT ALERTS (Telegram)
#
#   1. On Telegram, message @BotFather -> /newbot -> copy the token.
#   2. Send any message to your new bot, then open:
#        https://api.telegram.org/bot<TOKEN>/getUpdates
#      and copy  result[0].message.chat.id
#   3. Fill in the three values below and set ALERTS_ENABLED=1.
#   4. Verify before any demo:  curl -X POST http://localhost:8000/api/alerts/test
# ---------------------------------------------------------------------------
ALERTS_ENABLED=0
ALERT_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SECS=30
ALERT_MAX_RETRIES=2
ALERT_TIMEOUT_SECS=8
