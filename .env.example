# ---------------------------------------------------------------------------
# ThreatWatch configuration
# Copy to `.env` and edit.  `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WEBSOCKET_FPS=20

# --- camera / vision ------------------------------------------------------
# Set THREATWATCH_VISION=0 (or run `python run.py --no-vision`) to disable the
# camera and pose detection entirely.
THREATWATCH_VISION=1
CAMERA_INDEX=0
YOLO_MODEL_NAME=yolov8n-pose.pt

# --- hardware link --------------------------------------------------------
SERIAL_PORT=COM3
SERIAL_BAUD=115200

# ---------------------------------------------------------------------------
# THREAT ALERTS (Telegram / ntfy / Console)
#
# Channels: ALERT_CHANNEL=telegram | ntfy | telegram,ntfy | console
#
# Telegram:
#   1. Message @BotFather -> /newbot -> copy token.
#   2. Send message to bot -> open https://api.telegram.org/bot<TOKEN>/getUpdates
#      and copy result[0].message.chat.id
#
# ntfy.sh (useful for Tasker / emergency SMS triggers):
#   Set NTFY_TOPIC=your_topic_name (and optional NTFY_SERVER / NTFY_TOKEN)
# ---------------------------------------------------------------------------
ALERTS_ENABLED=0
ALERT_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
ALERT_COOLDOWN_SECS=30
ALERT_MAX_RETRIES=2
ALERT_TIMEOUT_SECS=8
